{
	"name": "lockin",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"bin": {
		"study": "build/cli/study.js"
	},
	"files": [
		"dist",
		"build"
	],
	"scripts": {
		"dev": "vite",
		"start": "npm run build && node build/cli/study.js",
		"build": "vite build && tsc -p tsconfig.cli.json",
		"prepack": "npm run build",
		"install:global": "npm pack && npm install -g ./lockin-$npm_package_version.tgz",
		"typecheck": "tsc --noEmit",
		"lint": "biome check . && tsc --noEmit",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@fontsource-variable/archivo": "^5.3.0",
		"@playwright/test": "^1.65.1",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
