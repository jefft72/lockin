{
	"name": "lockin",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite",
		"start": "vite build && vite preview --open",
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"lint": "biome check . && tsc --noEmit",
