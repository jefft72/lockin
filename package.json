		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@fontsource-variable/archivo": "^5.3.0",
		"@playwright/test": "^1.65.1",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
